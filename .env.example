# Copy to .env on the machine that runs it. NEVER commit .env. Fill secrets by hand (nano), not via chat.
# Legacy names INSTAGRAM_ACCESS_TOKEN / INSTAGRAM_USER_ID / INSTAGRAM_MODE / MCP_AUTH_TOKEN are also accepted.

# ---- Mode: mock (fixtures, no network) | live (real Graph API)
MODE=live

# ---- Instagram / Meta
IG_ACCESS_TOKEN=
IG_USER_ID=17841423089085521
FB_PAGE_ID=1481254898400944
META_APP_ID=1503417951637249
META_APP_SECRET=
GRAPH_API_VERSION=v27.0

# ---- MCP endpoint key (>= 32 chars): openssl rand -base64 36 | tr -d '\n=+/'
MCP_API_KEY=

# ---- Deployment
PUBLIC_HOST=flashly-mcp-bk.denmarkeast.cloudapp.azure.com
POSTGRES_PASSWORD=
# must be URL-safe: openssl rand -hex 24

# ---- Collector
COLLECT_INTERVAL_SECONDS=3600
COLLECT_MAX_MEDIA=200

# ---- Token expiry warnings (daily check is NOT implemented yet: the collector checks every run)
TOKEN_WARN_DAYS=14,7,3
NOTIFY_CHANNEL=log
# NOTIFY_CHANNEL=telegram -> TELEGRAM_BOT_TOKEN, TELEGRAM_CHAT_ID (not implemented yet)
# NOTIFY_CHANNEL=email    -> SMTP_HOST, SMTP_USER, SMTP_PASSWORD, NOTIFY_EMAIL_TO (not implemented yet)

# ---- Transcription (stage 6, not implemented yet)
TRANSCRIPTION_PROVIDER=faster-whisper
TRANSCRIPTION_API_KEY=
